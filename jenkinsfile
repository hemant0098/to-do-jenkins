pipeline {
    agent any

    environment {
        BACKEND_IMAGE_VERSION = "v1.6"
        FRONTEND_IMAGE_VERSION = "v1.6"
        ECR_REGISTRY = "059310318163.dkr.ecr.ap-south-1.amazonaws.com"
        BACKEND_REPO = "media-manager-backend"
        FRONTEND_REPO = "media-manager-frontend"
    }

    stages {
        stage('Build') {
            steps {
                script {
                    if (sh(script: "docker image inspect media-backend:${BACKEND_IMAGE_VERSION} > /dev/null 2>&1", returnStatus: true) ==0) {
                        echo "Backend image already exists. Skipping build."
                    } else {
                        echo "Building backend image..."
                        sh "docker build -t media-backend:${BACKEND_IMAGE_VERSION} -f Application-Code/backend/Dockerfile ./Application-Code/backend"
                    } 
                    if (sh(script: "docker image inspect media-frontend:${FRONTEND_IMAGE_VERSION} > /dev/null 2>&1", returnStatus: true) ==0) {
                        echo "Frontend image already exists. Skipping build."
                    } else {
                        echo "Building frontend image..."
                        sh "docker build -t media-frontend:${FRONTEND_IMAGE_VERSION} -f Application-Code/frontend/Dockerfile ./Application-Code/frontend"
                    }
                }
            }
        }
        stage('push to ECR') {
            steps {
                script {
                        sh "aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
                    if (sh(script: "docker image inspect ${ECR_REGISTRY}/${BACKEND_REPO}:${BACKEND_IMAGE_VERSION} > /dev/null 2>&1", returnStatus: true) ==0) {
                        echo "Backend image already exists in ECR. Skipping push."
                    } else {
                        echo "Pushing backend image to ECR..."
                        sh "docker tag media-backend:${BACKEND_IMAGE_VERSION} ${ECR_REGISTRY}/${BACKEND_REPO}:${BACKEND_IMAGE_VERSION}"
                        sh "docker push ${ECR_REGISTRY}/${BACKEND_REPO}:${BACKEND_IMAGE_VERSION}"
                    }
                    if (sh(script: "docker image inspect ${ECR_REGISTRY}/${FRONTEND_REPO}:${FRONTEND_IMAGE_VERSION} > /dev/null 2>&1", returnStatus: true) ==0) {
                        echo "Frontend image already exists in ECR. Skipping push."
                    } else {
                        echo "Pushing frontend image to ECR..."
                        sh "docker tag media-frontend:${FRONTEND_IMAGE_VERSION} ${ECR_REGISTRY}/${FRONTEND_REPO}:${FRONTEND_IMAGE_VERSION}"
                        sh "docker push ${ECR_REGISTRY}/${FRONTEND_REPO}:${FRONTEND_IMAGE_VERSION}"
                    }
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    sh '''
                    kubectl apply -f k8s/mongodb-service.yml
                    kubectl apply -f k8s/mongodb-statefulset.yml
                    kubectl apply -f k8s/backend-deployment.yml
                    kubectl apply -f k8s/backend-service.yml
                    kubectl apply -f k8s/frontend-deployment.yml
                    kubectl apply -f k8s/frontend-service.yml"
                 '''
                }
            }
        }
    }
}